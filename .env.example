# Postgres connection string
# Local default (matches docker-compose.yml defaults):
DATABASE_URL=postgresql://arkhana:arkhana@localhost:5432/arkhana

# Secret key for better-auth — must be at least 32 characters
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string

# Full base URL of the app — MUST use https:// in production
BETTER_AUTH_URL=http://localhost:3000

# Port to listen on
PORT=3000

# development | production | test
NODE_ENV=development

# Push notifications (optional — run `node scripts/generate-vapid-keys.js` to generate)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@arkhana.app

# SMTP for transactional emails (password reset, etc.)
# For local postfix on Dokku host: SMTP_HOST=172.17.0.1, SMTP_PORT=25, no user/pass needed
# For external provider (Resend, etc.): SMTP_HOST=smtp.resend.com, SMTP_PORT=465, user/pass required
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@arkhana.app
