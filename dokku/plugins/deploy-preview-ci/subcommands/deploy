#!/usr/bin/env bash
# Usage: dokku deploy-preview-ci:deploy <app> <image:tag> <db_action:push|migrate> [seed]
# $1 is the full command name (deploy-preview-ci:deploy), real args start at $2
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

APP="$2"
IMAGE="$3"
DB_ACTION="${4:-push}"
SEED="${5:-}"

if [[ -z "$APP" || -z "$IMAGE" ]]; then
  echo "Usage: dokku deploy-preview-ci:deploy <app> <image:tag> <db_action:push|migrate> [seed]"
  exit 1
fi

dokku git:from-image "$APP" "$IMAGE"

if [[ "$DB_ACTION" == "migrate" ]]; then
  dokku run "$APP" pnpm db:migrate
else
  dokku run "$APP" pnpm db:push --force
fi

if [[ "$SEED" == "seed" ]]; then
  dokku run "$APP" pnpm db:seed
fi
