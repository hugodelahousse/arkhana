#!/usr/bin/env bash
# Usage: dokku arkhana-ci:setup <app> <domain> <better_auth_secret_b64>
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

APP="$1"
DOMAIN="$2"
# Secret is base64-encoded to survive SSH argument quoting
BETTER_AUTH_SECRET=$(printf '%s' "$3" | base64 -d)

if [[ -z "$APP" || -z "$DOMAIN" || -z "$3" ]]; then
  echo "Usage: dokku arkhana-ci:setup <app> <domain> <better_auth_secret_b64>"
  exit 1
fi

# App
dokku apps:exists "$APP" 2>/dev/null || dokku apps:create "$APP"

# Postgres
dokku postgres:exists "${APP}-db" 2>/dev/null || dokku postgres:create "${APP}-db"
dokku postgres:linked "${APP}-db" "$APP" 2>/dev/null || dokku postgres:link "${APP}-db" "$APP"

# Config (always set in case secrets rotated)
dokku config:set --no-restart "$APP" \
  NODE_ENV=production \
  BETTER_AUTH_SECRET="$BETTER_AUTH_SECRET" \
  BETTER_AUTH_URL="https://$DOMAIN"

# Domain + port (idempotent)
if ! dokku domains:report "$APP" --domains-app-vhosts 2>/dev/null | grep -qF "$DOMAIN"; then
  dokku domains:set "$APP" "$DOMAIN"
  dokku ports:add "$APP" http:80:3000
fi

# SSL (best-effort — may fail if DNS not yet propagated)
dokku letsencrypt:enable "$APP" || true
